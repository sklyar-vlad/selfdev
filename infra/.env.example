ENV="development" # production
MODE=development

# backend
HOST="localhost"
ADDR=":8080"
READ_TIMEOUT=10
WRITE_TIMEOUT=10
IDLE_TIMEOUT=60
MIDDLEWARE="http://self-dev.localhost"

# jwt
API_SECRET=

# auth
AUTH_CLIENT_ID=7987350089e3975b24ad
AUTH_CLIENT_SECRET=selfdev-local-client-secret
REDIRECT_URI=http://self-dev.localhost
COOKIE_DOMAIN=
COOKIE_SECURE=false

# database
POSTGRES_DB=self-dev
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_URL=postgres://admin:admin@db:5432/self-dev
REDIS_URL=redis://redis:6379/0

# goose environment
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://admin:admin@localhost:5432/self-dev
GOOSE_MIGRATION_DIR=./backend/migrations
